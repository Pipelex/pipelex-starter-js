# Pipelex API endpoint and credentials.
# Get an API key at https://app.pipelex.com.
# Note: `npm run codegen` currently needs PIPELEX_BASE_URL=https://api-dev.pipelex.com
# — see README "Generated types". Running the app works fine against the
# default hosted URL below.
PIPELEX_BASE_URL=https://api.pipelex.com
PIPELEX_API_KEY=

# Default execution mode for the examples: "durable" (start + poll, survives the
# hosted ~30s cap, streams live status) or "blocking" (one synchronous execute).
# Each example also has a runtime toggle. Defaults to "durable" when unset.
NEXT_PUBLIC_EXECUTION_MODE=durable
